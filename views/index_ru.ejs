<!DOCTYPE html>
<html lang="en">
    <% const imagePath = `./images/IMG_${moonDay}.jpg`%>    
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🌘 Лунный день</title>
    <link rel="stylesheet" href="/styles/main.css"/>
    <style>
        .background-image {
            background-image: url(<%=imagePath%>);
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            /* margin-bottom: 10px;
            height: 100%; */
        };

        
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <% if (homeNav == 0) { %>
            <div class="navbar-icons">
                <a class="navbar-home" href="/Ru">
                    <!-- <p><strong>Home</strong></p></a>   -->
                    <p>Домой</p></a>   
            </div>
            <% } else { %>    
            <div class="navbar-icons"> 
                <a class="navbar-previous" href="/previousRu">
                    <img src="images/arrow-left.svg" alt="caret-left" width="30" height="30" class="navbar-icon">
                </a>
                <a class="navbar-next" href="/nextRu">
                    <img src="images/arrow-right.svg" alt="caret-right" width="30" height="30" class="navbar-icon">
                </a>
            </div>
            <% } %>

            <div clas="languages">
                <!-- <button >Eng</button>
                <button >Ru</button> -->
                <a class="navbar-home" href="/"><button >Eng</button></a>
                <a class="navbar-home" href="/Ru"><button>Ru</button></a>
                
            </div>
            
            <a class="navbar-calendar" href="#">
                <img src="images/calendar.svg" alt="calendar icon" width="30" height="30" fill="currentcolor" class="navbar-icon">
            </a>
          
        </div>
    </nav>
    
    <div class="flex-container background-image" >
       <div class="card today">
        <h2><%= dayActual %></h2>
        <h1><%= moonDayName %></h1>
        <h2><%= moonDay %> Лунный день</h2>
        <% if (moonTime == 0) { %>
        <h3></h3>   
        <% } else {%>    
        <h3>начало в <%= moonTime%></h3>
        <% } %>
        <img class="day-image" src = <%=imagePath%> />
        <h3><%= daySummary %></h3>
        <p><strong>Важно в этот день: </strong> <%= todo %> </p>
        <p><strong>Не стоит в этот день:</strong> <%= avoid %></p>
        <p><%= fullDescription %></p>
       </div>
      

      <!-- <div class="card calendar">
        <p> here could be table with calendar</p>
      </div> -->
    </div>

    <footer class="footer">
        <div class="container">
            <p>LenaChe</p>
            <p><%= new Date().getFullYear() %></p>
        </div>
        
    </footer>
</body>
</html>